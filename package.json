{
  "name": "dsh-jev-gate",
  "version": "0.8.2",
  "type": "module",
  "description": "Đưa Jev (TypeSafe System One) vào 8 khoảnh khắc đắt giá của DSH: gate tool nguy hiểm, kiểm hoàn thành, chọn reasoning effort, chọn hướng tiếp cận, chọn file nạp vào context, phục hồi khi tool lỗi, tự review chất lượng khi turn kết thúc, và leo thang tìm nguồn bằng jevgrep khi việc là \"tìm X ở đâu\".",
  "license": "MIT",
  "author": "dungle03",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dungle03/dsh-jev-gate.git"
  },
  "homepage": "https://github.com/dungle03/dsh-jev-gate#readme",
  "bugs": {
    "url": "https://github.com/dungle03/dsh-jev-gate/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "jev",
    "typesafe",
    "system-one",
    "reasoning-effort",
    "context-selection",
    "tool-recovery",
    "guardrails",
    "quality-review",
    "jevgrep",
    "source-retrieval"
  ],
  "main": "./lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "verify.sh",
    "tools",
    "tests",
    "assets"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.1.0-rc.7"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  }
}
